# =============================================================================
# VoiceBank Inclusive — environment template (§16 BUILD_SPEC)
# Copy to .env and fill in. Container env overrides .env. Never commit secrets.
# =============================================================================

# --- Provider selection: `vnpt` (real) or `smoke` (offline mock) -------------
STT_PROVIDER=smoke
TTS_PROVIDER=smoke
NLU_PROVIDER=smoke

# --- VNPT SmartVoice (STT/TTS) ----------------------------------------------
SMARTVOICE_API_KEY=
SMARTVOICE_STT_ENDPOINT=
SMARTVOICE_TTS_ENDPOINT=
SMARTVOICE_VOICE_ID=

# --- VNPT Smartbot (NLU + LLM) ----------------------------------------------
SMARTBOT_API_KEY=
SMARTBOT_ENDPOINT=
SMARTBOT_BOT_ID=

# --- VNPT eKYC / vnFace / SmartReader ---------------------------------------
EKYC_API_KEY=
EKYC_ENDPOINT=
VNFACE_API_KEY=

# --- VNPT vnSocial / SmartUX ------------------------------------------------
VNSOCIAL_API_KEY=
SMARTUX_KEY=

# --- Ports -------------------------------------------------------------------
VOICE2TEXT_PORT=18889
MOCKAPI_PORT=18890
WEB_PORT=18891

# --- Service wiring ----------------------------------------------------------
BANKING_BACKEND_BASE_URL=http://localhost:18890
MOCKAPI_BASE_URL=http://localhost:18890
AUDIO_BACKEND_BASE_URL=http://localhost:18889

# --- Audio / VAD -------------------------------------------------------------
WEB_AUDIO_OUT_SAMPLE_RATE=24000
WEB_AUDIO_OUT_CHUNK_MS=40
WEB_VAD_THRESHOLD=0.5
WEB_ALLOW_INTERRUPTIONS=true

# --- Idle / Agent behaviour --------------------------------------------------
IDLE_TIMEOUT_SECS=20
MAX_IDLE_REPROMPTS=2
AGENT_AVAILABLE_START=8
AGENT_AVAILABLE_END=22

# --- Business constants (must match §7) -------------------------------------
TRANSFER_KYC_THRESHOLD=10000000
TRANSFER_DAILY_KYC_THRESHOLD=20000000
MAX_AUTH_ATTEMPTS=5
LOCK_MINUTES=15
OTP_TTL_MINUTES=5

# --- Database (json | postgres) ---------------------------------------------
DB_SOURCE=json
DATABASE_URL=postgresql://voicebank:voicebank@localhost:5432/voicebank
POSTGRES_USER=voicebank
POSTGRES_PASSWORD=voicebank
POSTGRES_DB=voicebank

# --- Object storage (recordings) --------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=voicebank-recordings
S3_REGION=ap-southeast-1
MINIO_SERVER=localhost:9000

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_DIR=./logs

# --- Frontend / CORS ---------------------------------------------------------
NEXT_PUBLIC_ORCHESTRATOR_BASE_URL=http://localhost:18889
FRONTEND_CORS_ORIGINS=http://localhost:18891

# --- Feature flag: demo-only endpoints (default OFF) ------------------------
FEATURE_DEMO=false
